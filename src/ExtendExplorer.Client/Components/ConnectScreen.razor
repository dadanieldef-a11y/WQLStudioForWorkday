@namespace ExtendExplorer.Client.Components
@inject ApiClient Api
@inject Connections Store
@inject NavigationManager Nav
@using System.Text.Json

@* Shown when there's no session: pick/manage a tenant connection, then Connect
   kicks off OAuth (POSTs the chosen connection, navigates to the authorize URL
   the server returns). Port of components/ConnectScreen.tsx. *@

<div class="connect-screen">
    <div class="connect-card">
        <div class="brand">
            <img class="brand-logo brand-logo-lg" src="wqlstudio-icon-128x128.png" alt="WQL Studio" width="40" height="40" />
            <span class="brand-name">WQL Studio</span>
            <span class="brand-sub">WQL workbench</span>
        </div>
        <p class="connect-lead">
            Choose a Workday tenant to connect to. Each tenant needs an API client
            (Authorization Code + PKCE) registered with this app's redirect URI.
        </p>
        @if (_error is not null)
        {
            <div class="connect-error">@_error</div>
        }

        <a class="guide-link" href="guide.html" target="_blank" rel="noopener" style="display:inline-block;margin:2px 0 10px">📖 Read the user guide</a>

        <ConnectionsManager OnChange="OnConnectionsChanged" />

        <button class="btn primary connect-go" @onclick="Connect"
                disabled="@(_active is null || !_active.IsComplete() || _connecting)"
                title="@(_active is not null && !_active.IsComplete() ? "This connection is missing required fields — edit it before connecting." : null)">
            @(_connecting ? "Connecting…"
              : _active is null ? "Add a connection to continue"
              : !_active.IsComplete() ? $"“{_active.Name}” is missing required fields"
              : $"Connect to {_active.Name}")
        </button>
    </div>
</div>

@code {
    private Connection? _active;
    private bool _connecting;
    private string? _error;

    private static readonly Dictionary<string, string> AuthErrors = new()
    {
        ["state_mismatch"] = "Login state didn't match — please try connecting again.",
        ["missing_pkce_verifier"] = "The login session expired. Try again.",
        ["missing_connection_context"] = "Connection details were lost mid-login. Try again.",
        ["missing_code_or_state"] = "Workday didn't return a login code. Try again.",
    };

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var authError = ReadQueryParam(uri.Query, "auth_error");
        if (!string.IsNullOrEmpty(authError))
        {
            _error = AuthErrors.TryGetValue(authError, out var friendly) ? friendly : $"Login failed: {authError}";
            // Drop the param so a refresh doesn't re-show it.
            Nav.NavigateTo(uri.GetLeftPart(UriPartial.Path), forceLoad: false, replace: true);
        }
        _active = await Store.GetActiveConnectionAsync();
    }

    private async Task OnConnectionsChanged()
    {
        _active = await Store.GetActiveConnectionAsync();
        StateHasChanged();
    }

    private async Task Connect()
    {
        var conn = await Store.GetActiveConnectionAsync();
        if (conn is null || _connecting) return;
        _connecting = true;
        _error = null;
        try
        {
            var payload = new LoginRequest
            {
                Name = conn.Name,
                AuthorizeEndpoint = conn.AuthorizeEndpoint,
                TokenEndpoint = conn.TokenEndpoint,
                WqlBase = conn.WqlBase,
                ClientId = conn.ClientId,
                ClientSecret = conn.ClientSecret,
                TenantAlias = conn.TenantAlias,
                BoCompanyId = conn.BoCompanyId,
                ApiBase = conn.ApiBase,
                ReturnTo = "/",
            };
            var (status, body) = await Api.PostRawAsync("/api/auth/login", payload);
            var data = TryParse<LoginResponse>(body);
            if (status < 200 || status >= 300 || data is null || string.IsNullOrEmpty(data.RedirectUrl))
            {
                _error = $"Couldn't start login: {ErrorFrom(body) ?? status.ToString()}";
                _connecting = false;
                return;
            }
            Nav.NavigateTo(data.RedirectUrl, forceLoad: true); // off to Workday
        }
        catch (Exception e)
        {
            _error = e.Message;
            _connecting = false;
        }
    }

    // Minimal query reader (avoids a WebUtilities dependency in WASM).
    private static string? ReadQueryParam(string query, string key)
    {
        if (string.IsNullOrEmpty(query)) return null;
        var q = query.StartsWith("?") ? query[1..] : query;
        foreach (var pair in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            var k = eq >= 0 ? pair[..eq] : pair;
            if (Uri.UnescapeDataString(k) == key)
                return eq >= 0 ? Uri.UnescapeDataString(pair[(eq + 1)..]) : "";
        }
        return null;
    }

    private static T? TryParse<T>(string body)
    {
        try { return JsonSerializer.Deserialize<T>(body, ApiClient.JsonOpts); }
        catch { return default; }
    }

    private static string? ErrorFrom(string body)
    {
        try
        {
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.ValueKind == JsonValueKind.Object
                && doc.RootElement.TryGetProperty("error", out var e)
                && e.ValueKind == JsonValueKind.String)
                return e.GetString();
        }
        catch { }
        return null;
    }
}
