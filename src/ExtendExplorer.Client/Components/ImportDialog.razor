@namespace ExtendExplorer.Client.Components
@inject ApiClient Api
@inject BoFields BoFieldsSvc
@inject Interop Interop
@using System.Net
@using System.Text
@using System.Text.Json.Nodes

@* Load rows from a JSON file written by Export and create them in the chosen
   custom BO. Records are sanitised first: Workday-managed fields are dropped and
   references are reduced to { id }, so a file exported from this tool imports
   cleanly. Inserts go through the same bulk endpoint as Bulk insert.

   There is no row limit: the file is read record by record, then sent 100 rows
   at a time with a progress bar. The run can be stopped, and a stopped or
   session-expired run offers the rows that weren't sent as a file. *@

<div class="modal-overlay">
    <div class="modal modal-wide modal-xl" @onclick:stopPropagation="true">
        <div class="modal-head">
            <div>
                <div class="modal-title">@(_phase == "done" ? "Import result" : "Import rows from file")</div>
                <div class="modal-sub">@BoName</div>
            </div>
            @if (_phase != "running")
            {
                <button class="modal-x" @onclick="OnClose">×</button>
            }
        </div>

        <div class="modal-body rec-body">
            @if (_error is not null)
            {
                <div class="connect-error" style="white-space:pre-wrap">@_error</div>
            }

            @if (_phase == "edit")
            {
                <p class="bulk-hint">
                    Choose a JSON file previously written by <strong>Export all rows</strong> (a JSON array of
                    records). Rows are created as <em>new</em> instances — this restores data, it doesn't
                    overwrite existing rows. Every row in the file is imported; there is no row limit.
                </p>

                <div class="rec-field">
                    <label class="rec-key">File</label>
                    <label class="btn" style="cursor:pointer;margin:0;align-self:flex-start">
                        → Choose JSON file
                        <InputFile OnChange="OnPickFile" accept=".json,application/json" style="display:none" />
                    </label>
                </div>

                @if (_reading)
                {
                    <p class="del-warn">Reading @_fileName… @_readCount.ToString("N0") rows so far.</p>
                }

                @if (_fileName is not null && !_reading)
                {
                    <div class="note-inline">
                        <strong>@_fileName</strong> — @_records.Count.ToString("N0") row@(_records.Count == 1 ? "" : "s") ready.
                        <br />
                        <strong>Sending @_columns.Count field@(_columns.Count == 1 ? "" : "s"):</strong>
                        <code>@string.Join(", ", _columns.Take(14))</code>@(_columns.Count > 14 ? "…" : "")
                        @if (_systemDropped.Count > 0)
                        {
                            <br />
                            <text>Skipped — Workday sets these itself: <code>@string.Join(", ", _systemDropped.Take(10))</code>@(_systemDropped.Count > 10 ? "…" : "").</text>
                        }
                        @if (_notWritable.Count > 0)
                        {
                            <br />
                            <span class="bulk-warn">
                                Skipped — not writable fields on <code>@BoName</code>:
                                <code>@string.Join(", ", _notWritable.Take(10))</code>@(_notWritable.Count > 10 ? "…" : "").
                                If you expected these to import, check you picked the matching file for this business object.
                            </span>
                        }
                    </div>

                    @if (_records.Count > 0)
                    {
                        <div class="bulk-preview-wrap">
                            <table class="bulk-preview">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        @foreach (var h in PreviewCols)
                                        {
                                            <th @key="h">@h</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Math.Min(PreviewRows, _records.Count); i++)
                                    {
                                        var rec = _records[i];
                                        <tr @key="i">
                                            <td>@(i + 1)</td>
                                            @foreach (var h in PreviewCols)
                                            {
                                                <td @key="h">@CellText(rec, h)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (_records.Count > PreviewRows)
                        {
                            <p class="bulk-hint">…and @((_records.Count - PreviewRows).ToString("N0")) more.</p>
                        }
                    }
                }
            }

            @if (_phase == "running")
            {
                <p class="del-warn">@RunningText</p>
                <div class="progress" role="progressbar" aria-label="Import progress"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ImportPercent">
                    <div class="progress-fill" style="width:@(ImportPercent)%"></div>
                </div>
                <p class="bulk-hint">
                    @_okCount.ToString("N0") created, @_failCount.ToString("N0") failed so far.
                    Rows are sent @ChunkSize at a time. Keep this tab open until it finishes.
                </p>
                @ResultList
            }

            @if (_phase == "done")
            {
                <p class="del-summary">@_okCount.ToString("N0") imported@(_failCount > 0 ? $", {_failCount:N0} failed" : "").</p>
                @if (_stopReason == "expired")
                {
                    <div class="connect-error">
                        Your Workday session expired part-way through.
                        <strong>@UnsentCount.ToString("N0") row@(UnsentCount == 1 ? "" : "s") (from row @((_unsentFrom + 1).ToString("N0")) onward) were not sent.</strong>
                        The earlier rows were already sent, so importing the original file again would create them twice.
                        Save the unsent rows, reconnect, then import that file instead.
                    </div>
                }
                else if (_stopReason == "cancelled")
                {
                    <div class="connect-error">
                        Import stopped.
                        <strong>@UnsentCount.ToString("N0") row@(UnsentCount == 1 ? "" : "s") (from row @((_unsentFrom + 1).ToString("N0")) onward) were not sent.</strong>
                        The earlier rows were already sent, so importing the original file again would create them twice.
                        To finish later, save the unsent rows and import that file.
                    </div>
                }
                @if (_unsentSaved)
                {
                    <p class="bulk-hint">Unsent rows saved.</p>
                }
                @if (!ShowAllRows)
                {
                    <p class="bulk-hint">
                        @(_failCount == 0
                            ? "No rows failed."
                            : _failCount > _results.Count
                                ? $"Showing the first {_results.Count:N0} of {_failCount:N0} failed rows."
                                : "Showing the failed rows.")
                    </p>
                }
                @ResultList
            }
        </div>

        <div class="modal-foot">
            @if (_phase == "edit")
            {
                <button class="btn" @onclick="OnClose">Cancel</button>
                <button class="btn btn-primary del-go" @onclick="Import" disabled="@(_records.Count == 0 || _reading)">
                    Import @(_records.Count > 0 ? _records.Count.ToString("N0") : "") row@(_records.Count == 1 ? "" : "s")
                </button>
            }
            else if (_phase == "running")
            {
                <button class="btn" @onclick="@(() => _cancelRequested = true)" disabled="@_cancelRequested">
                    @(_cancelRequested ? "Stopping…" : "Stop import")
                </button>
            }
            else if (_stopReason == "expired")
            {
                <button class="btn" @onclick="SaveUnsent">⤓ Save unsent rows</button>
                <button class="btn btn-primary" @onclick="@(() => Api.RedirectToLogin())">Reconnect</button>
            }
            else if (_stopReason == "cancelled")
            {
                <button class="btn" @onclick="SaveUnsent">⤓ Save unsent rows</button>
                <button class="btn btn-primary" @onclick="Finish">Done</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="Finish">Done</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string BoName { get; set; } = "";
    [Parameter] public string? DataSourceId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnImported { get; set; }

    private const int ChunkSize = 100;
    private const int PreviewRows = 5;
    // Largest file the browser will hand over. The file is read as a stream, so
    // this is a sanity bound rather than a memory budget.
    private const long MaxFileBytes = 2L * 1024 * 1024 * 1024;
    // Up to this many rows, every row's outcome is listed (as before). Beyond
    // it only failed rows are listed — a result line per row would swamp the
    // page on a large import — and only the first FailListMax of those.
    private const int FullListMax = 500;
    private const int FailListMax = 500;

    // Workday-managed: present in an export for reference, never settable.
    private static readonly HashSet<string> SystemKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "id", "href", "descriptor", "wid", "workdayID", "createdMoment", "updatedMoment",
        "classOfInstance1", "referenceID1", "lastFunctionallyUpdated",
        "currentOMSVersion", "standardWorkdayID", "_links",
    };

    private sealed class RowResult
    {
        public int Index;
        public bool Ok;
        public int Status;
        public string? Id;
        public string? Error;
    }

    private string _phase = "edit"; // edit | running | done
    private string? _error;
    private string? _fileName;
    private bool _reading;
    private int _readCount;
    private List<JsonObject> _records = new();
    private List<string> _columns = new();
    private readonly List<string> _systemDropped = new();
    private readonly List<string> _notWritable = new();
    private readonly List<RowResult> _results = new();
    private int _progress;
    private int _okCount;
    private int _failCount;
    private List<BoFieldDto> _meta = new();

    // Parse state, filled record by record while the file is read.
    private readonly Dictionary<string, BoFieldDto> _writable = new(StringComparer.OrdinalIgnoreCase);
    private bool _haveMeta;
    private readonly HashSet<string> _systemDroppedSet = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _notWritableSet = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _seenCols = new(StringComparer.OrdinalIgnoreCase);

    // A run that ends early — the session expired ("expired") or the user
    // stopped it ("cancelled") — keeps its results on screen, and the rows from
    // _unsentFrom on can be saved to a file for a later import (instead of the
    // original file being re-run, which would duplicate the rows already created).
    private string? _stopReason;
    private int _unsentFrom = -1;
    private bool _cancelRequested;
    private bool _unsentSaved;
    private int UnsentCount => _unsentFrom < 0 ? 0 : Math.Max(0, _records.Count - _unsentFrom);

    private bool ShowAllRows => _records.Count <= FullListMax;
    private List<string> PreviewCols => _columns.Take(8).ToList();
    private int ImportPercent => _records.Count == 0 ? 0 : (int)Math.Min(100, _progress * 100L / _records.Count);
    private string RunningText => _cancelRequested
        ? "Stopping after the current batch…"
        : $"Importing… {_progress:N0} of {_records.Count:N0} rows ({ImportPercent}%)";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DataSourceId))
            _meta = await BoFieldsSvc.FetchByIdAsync(DataSourceId) ?? new();
    }

    // ── reading the file ─────────────────────────────────────────────────
    private void ResetParsed()
    {
        _records = new();
        _columns = new();
        _systemDropped.Clear();
        _notWritable.Clear();
        _systemDroppedSet.Clear();
        _notWritableSet.Clear();
        _seenCols.Clear();
        _readCount = 0;

        // The BO's own field metadata is the allow-list when we have it: it
        // already excludes Workday-managed fields AND the BO's self-reference
        // (a field named after the object whose id is the row's workdayID),
        // which a fixed name list can't know about. Without metadata we fall
        // back to dropping the well-known system keys plus anything that looks
        // like a self-reference.
        _writable.Clear();
        foreach (var m in _meta) _writable[m.Key] = m;
        _haveMeta = _writable.Count > 0;
    }

    private async Task OnPickFile(InputFileChangeEventArgs e)
    {
        _error = null;
        ResetParsed();

        var file = e.File;
        if (file is null) return;
        _fileName = file.Name;
        _reading = true;
        StateHasChanged();

        try
        {
            // Read the array one record at a time, so the whole file never has to
            // be held as text — this is what lets a file of any length import.
            var streamed = false;
            try
            {
                await using var stream = file.OpenReadStream(MaxFileBytes);
                await foreach (var item in JsonSerializer.DeserializeAsyncEnumerable<JsonElement>(stream))
                {
                    AddRecord(item);
                    if (++_readCount % 2000 == 0)
                    {
                        StateHasChanged();
                        await Task.Yield();
                    }
                }
                streamed = true;
            }
            catch (JsonException)
            {
                // Not a plain top-level array (an object wrapping one, or a file
                // saved with a byte-order mark) — read it whole instead.
            }

            if (!streamed)
            {
                ResetParsed();
                using var stream = file.OpenReadStream(MaxFileBytes);
                using var reader = new StreamReader(stream);
                ParseWhole(await reader.ReadToEndAsync());
            }

            _systemDropped.AddRange(_systemDroppedSet);
            _notWritable.AddRange(_notWritableSet);

            if (_error is null && _records.Count == 0)
                _error = _haveMeta
                    ? "No writable fields found in that file for this business object — check you picked the right file."
                    : "No importable records found in that file.";
        }
        catch (Exception ex)
        {
            ResetParsed();
            _error = $"Couldn't read the file: {ex.Message}";
            _fileName = null;
        }
        finally
        {
            _reading = false;
        }
    }

    // Whole-file fallback: a bare array, or an object wrapping one
    // (e.g. { "data": [ … ] }).
    private void ParseWhole(string text)
    {
        using var doc = JsonDocument.Parse(text);
        var root = doc.RootElement;

        JsonElement arr;
        if (root.ValueKind == JsonValueKind.Array) arr = root;
        else if (root.ValueKind == JsonValueKind.Object
                 && root.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array) arr = d;
        else
        {
            _error = "That file isn't a JSON array of records.";
            return;
        }

        foreach (var item in arr.EnumerateArray())
        {
            AddRecord(item);
            _readCount++;
        }
    }

    // Sanitise one exported record and queue it for import.
    private void AddRecord(JsonElement item)
    {
        if (item.ValueKind != JsonValueKind.Object) return;

        // This row's own instance id, so a self-reference can be spotted
        // even without metadata.
        var selfId = Str(item, "workdayID") ?? Str(item, "standardWorkdayID");

        var rec = new JsonObject();
        foreach (var p in item.EnumerateObject())
        {
            if (SystemKeys.Contains(p.Name)) { _systemDroppedSet.Add(p.Name); continue; }

            if (_haveMeta)
            {
                if (!_writable.ContainsKey(p.Name))
                {
                    // The BO's own self-reference is Workday-managed rather
                    // than a mismatch, so report it as such.
                    if (IsSelfReference(p.Value, selfId)) _systemDroppedSet.Add(p.Name);
                    else _notWritableSet.Add(p.Name);
                    continue;
                }
            }
            else if (IsSelfReference(p.Value, selfId))
            {
                _systemDroppedSet.Add(p.Name);
                continue;
            }

            var node = Sanitize(p.Value);
            if (node is null) continue;

            // Export writes numbers as strings; send them back as the type
            // the field expects so Workday doesn't reject them.
            if (_haveMeta) node = Coerce(node, _writable[p.Name]);

            rec[p.Name] = node;
            if (_seenCols.Add(p.Name)) _columns.Add(p.Name);
        }
        if (rec.Count > 0) _records.Add(rec);
    }

    private static string? Str(JsonElement obj, string name) =>
        obj.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;

    // A reference back to the row itself (the BO's self-reference field): an
    // object whose id matches this record's own workdayID.
    private static bool IsSelfReference(JsonElement v, string? selfId) =>
        !string.IsNullOrEmpty(selfId)
        && v.ValueKind == JsonValueKind.Object
        && v.TryGetProperty("id", out var id)
        && id.ValueKind == JsonValueKind.String
        && id.GetString() == selfId;

    // "91000.75" → 91000.75, "true" → true, for fields the schema says are
    // numeric/boolean. Anything that doesn't parse is left as-is.
    private static JsonNode? Coerce(JsonNode node, BoFieldDto field)
    {
        if (node is not JsonValue jv || !jv.TryGetValue<string>(out var s)) return node;
        if (field.Type == "number"
            && double.TryParse(s, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var n))
            return JsonValue.Create(n);
        if (field.Type == "boolean" && bool.TryParse(s, out var b))
            return JsonValue.Create(b);
        return node;
    }

    // Reduce an exported value to what the API will accept: references become
    // { id }, empties are dropped, everything else passes through.
    private static JsonNode? Sanitize(JsonElement v)
    {
        switch (v.ValueKind)
        {
            case JsonValueKind.Object:
                if (v.TryGetProperty("id", out var idp) && idp.ValueKind == JsonValueKind.String)
                {
                    var id = idp.GetString();
                    return string.IsNullOrEmpty(id) ? null : new JsonObject { ["id"] = id };
                }
                return JsonNode.Parse(v.GetRawText());
            case JsonValueKind.Array:
                var arr = new JsonArray();
                foreach (var item in v.EnumerateArray())
                {
                    var n = Sanitize(item);
                    if (n is not null) arr.Add(n);
                }
                return arr.Count > 0 ? arr : null;
            case JsonValueKind.String:
                var s = v.GetString();
                return string.IsNullOrEmpty(s) ? null : JsonValue.Create(s);
            case JsonValueKind.Null:
            case JsonValueKind.Undefined:
                return null;
            default:
                return JsonNode.Parse(v.GetRawText());
        }
    }

    // ── importing ────────────────────────────────────────────────────────
    private void AddResult(RowResult r)
    {
        if (r.Ok) _okCount++; else _failCount++;
        if (ShowAllRows || (!r.Ok && _results.Count < FailListMax)) _results.Add(r);
    }

    private async Task Import()
    {
        _phase = "running";
        _error = null;
        _results.Clear();
        _progress = 0;
        _okCount = 0;
        _failCount = 0;
        _stopReason = null;
        _unsentFrom = -1;
        _cancelRequested = false;
        _unsentSaved = false;

        for (var start = 0; start < _records.Count; start += ChunkSize)
        {
            if (_cancelRequested)
            {
                // Stopped by the user between batches: everything from `start` on is unsent.
                _stopReason = "cancelled";
                _unsentFrom = start;
                break;
            }

            var chunk = _records.GetRange(start, Math.Min(ChunkSize, _records.Count - start));
            try
            {
                var (status, body) = await Api.PostRawAsync("/api/workday/insert-bulk",
                    new { boName = BoName, records = chunk });
                if (status == (int)HttpStatusCode.Unauthorized)
                {
                    // Nothing sent yet — just go back to the Connect screen.
                    if (start == 0) { Api.RedirectToLogin(); return; }
                    // Session expired mid-run. A 401 means this chunk was rejected,
                    // so everything from `start` on is unsent; keep what we have.
                    _stopReason = "expired";
                    _unsentFrom = start;
                    break;
                }

                if (status < 200 || status >= 300)
                {
                    var msg = ErrorFrom(body) ?? status.ToString();
                    for (var i = 0; i < chunk.Count; i++)
                        AddResult(new RowResult { Index = start + i, Ok = false, Status = status, Error = msg });
                }
                else
                {
                    var data = Deserialize<InsertBulkResponse>(body);
                    foreach (var r in data?.Results ?? new())
                        AddResult(new RowResult
                        {
                            Index = start + r.Index,
                            Ok = r.Ok,
                            Status = r.Status,
                            Id = r.Id,
                            Error = r.Error,
                        });
                }
            }
            catch (Exception e)
            {
                for (var i = 0; i < chunk.Count; i++)
                    AddResult(new RowResult { Index = start + i, Ok = false, Status = 0, Error = e.Message });
            }
            _progress = Math.Min(start + ChunkSize, _records.Count);
            StateHasChanged();
        }

        _phase = "done";
    }

    // Save the rows that were never sent (after a stop or a mid-run session
    // expiry) as a JSON array this dialog can load again. Written in pieces, so
    // a large remainder doesn't have to be built as one string.
    private async Task SaveUnsent()
    {
        if (_unsentFrom < 0 || _unsentFrom >= _records.Count) return;
        _error = null;

        var stamp = DateTime.Now.ToString("yyyy-MM-dd-HHmm");
        string? file;
        try
        {
            file = await Interop.ExportOpenAsync(
                $"{BoName}-unsent-{stamp}.json", "JSON file", "application/json", ".json");
        }
        catch (Exception e)
        {
            _error = $"Couldn't open a file to save to: {e.Message}";
            return;
        }
        if (file is null) return; // cancelled the Save dialog

        try
        {
            var sb = new StringBuilder();
            for (var i = _unsentFrom; i < _records.Count; i++)
            {
                sb.Append(i == _unsentFrom ? "[\n" : ",\n");
                sb.Append(_records[i].ToJsonString());
                if (sb.Length > 200_000)
                {
                    await Interop.ExportWriteAsync(file, sb.ToString());
                    sb.Clear();
                }
            }
            sb.Append("\n]");
            await Interop.ExportWriteAsync(file, sb.ToString());
            await Interop.ExportCloseAsync(file);
            _unsentSaved = true;
        }
        catch (Exception e)
        {
            await Interop.ExportAbortAsync(file);
            _error = $"Couldn't save the unsent rows: {e.Message}";
        }
    }

    private async Task Finish()
    {
        await OnImported.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private RenderFragment ResultList => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "del-idlist");
        var seq = 2;
        foreach (var r in _results)
        {
            builder.OpenElement(seq, "div");
            builder.SetKey(r.Index);
            builder.AddAttribute(seq + 1, "class", $"del-result{(r.Ok ? " ok" : " fail")}");
            builder.OpenElement(seq + 2, "span");
            builder.AddAttribute(seq + 3, "class", "del-result-id");
            builder.AddContent(seq + 4, $"Row {r.Index + 1}{(r.Ok && !string.IsNullOrEmpty(r.Id) ? $" · {r.Id}" : "")}");
            builder.CloseElement();
            builder.OpenElement(seq + 5, "span");
            builder.AddAttribute(seq + 6, "class", "del-result-status");
            builder.AddContent(seq + 7, r.Ok
                ? "created"
                : $"{(r.Status != 0 ? r.Status.ToString() : "error")}{(string.IsNullOrEmpty(r.Error) ? "" : $" · {r.Error}")}");
            builder.CloseElement();
            builder.CloseElement();
            seq += 10;
        }
        builder.CloseElement();
    };

    private static string CellText(JsonObject rec, string key)
    {
        if (!rec.TryGetPropertyValue(key, out var node) || node is null) return "";
        if (node is JsonObject o && o.TryGetPropertyValue("id", out var id)) return id?.ToString() ?? "";
        if (node is JsonArray a) return $"{a.Count} item{(a.Count == 1 ? "" : "s")}";
        return node.ToString();
    }

    private static T? Deserialize<T>(string body)
    {
        try { return JsonSerializer.Deserialize<T>(body, ApiClient.JsonOpts); }
        catch { return default; }
    }

    private static string? ErrorFrom(string body)
    {
        try
        {
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.ValueKind == JsonValueKind.Object
                && doc.RootElement.TryGetProperty("error", out var e)
                && e.ValueKind == JsonValueKind.String)
                return e.GetString();
        }
        catch { }
        return null;
    }
}
