@namespace ExtendExplorer.Client.Components

@* Query toolbar: mode switch (Select/Insert/Update/Delete), Run, limit, CSV
   export, row/time status. Sign out lives in the Explorer header. Port of
   components/Toolbar.tsx. *@

<div class="toolbar">
    <div class="mode-switch" role="group" aria-label="Query mode">
        @foreach (var m in Modes)
        {
            <button type="button"
                    class="@ModeClass(m)"
                    aria-pressed="@(Mode == m)"
                    @onclick="@(() => OnModeChange.InvokeAsync(m))">
                @m.ToLabel()
            </button>
        }
    </div>

    <button class="btn btn-primary" @onclick="OnRun" disabled="@Running">
        @(Running ? "Running…" : "Run")
        <span style="margin-left:8px">🟢</span>
    </button>

    <label class="limit">
        Limit
        <select value="@Limit"
                @onchange="OnLimitChanged">
            @foreach (var n in Limits)
            {
                <option value="@n" selected="@(n == Limit)">@n</option>
            }
        </select>
    </label>

    <button class="btn" @onclick="OnExport" disabled="@(!CanExport || Exporting)">
        @(Exporting ? "Exporting…" : "Export CSV")
    </button>

    <button class="btn" @onclick="OnSaveQuery" title="Save the editor query to a .wql file">
        Save query
    </button>
    <label class="btn" style="cursor:pointer;margin:0" title="Load a .wql/.txt file into the editor">
        Load query
        <InputFile OnChange="OnLoadFile" accept=".wql,.txt,.sql" style="display:none" />
    </label>

    <div class="status">
        @if (RowCount is not null)
        {
            <span>
                @RowCount row@(RowCount == 1 ? "" : "s")@(Total is not null && Total != RowCount ? $" of {Total}" : "")
            </span>
        }
        @if (ElapsedMs is not null)
        {
            <span class="dot">·</span>
            <span>@ElapsedMs ms</span>
        }
    </div>
</div>

@code {
    [Parameter] public bool Running { get; set; }
    [Parameter] public QueryMode Mode { get; set; }
    [Parameter] public EventCallback<QueryMode> OnModeChange { get; set; }
    [Parameter] public int Limit { get; set; }
    [Parameter] public EventCallback<int> OnLimitChange { get; set; }
    [Parameter] public EventCallback OnRun { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback OnSaveQuery { get; set; }
    [Parameter] public EventCallback<string> OnLoadQuery { get; set; }
    [Parameter] public bool CanExport { get; set; }
    [Parameter] public bool Exporting { get; set; }
    [Parameter] public long? RowCount { get; set; }
    [Parameter] public long? Total { get; set; }
    [Parameter] public long? ElapsedMs { get; set; }

    // 100 is the WCP API Gateway's maximum page size, so the Limit options stop
    // there — 500/1000 would fail with "limit parameter invalid". Use Export CSV
    // or Export mode to get more than a page's worth of rows out.
    private static readonly int[] Limits = { 10, 25, 50, 100 };
    private static readonly QueryMode[] Modes =
        { QueryMode.Select, QueryMode.Insert, QueryMode.Update, QueryMode.Delete, QueryMode.Export };

    private string ModeClass(QueryMode m) =>
        $"mode-btn mode-{m.ToWire()}{(Mode == m ? " active" : "")}";

    private async Task OnLimitChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
            await OnLimitChange.InvokeAsync(n);
    }

    private async Task OnLoadFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        try
        {
            using var stream = file.OpenReadStream(2 * 1024 * 1024); // 2 MB cap
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();
            await OnLoadQuery.InvokeAsync(text);
        }
        catch { /* unreadable file — ignore */ }
    }
}
